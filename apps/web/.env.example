# --- Database (Prisma Postgres: Vercel Storage > Create > Prisma Postgres) ---
# Use the direct postgres:// connection string (POSTGRES_URL on Vercel), not the prisma+postgres:// one.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/meeting_booking

# --- Auth ---
# development | test | production. Production refuses placeholder or short SECRET_KEY values.
# When unset, Vercel production deployments count as production automatically.
# APP_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=change-this-development-secret-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Room images (Vercel Blob: Vercel Storage > Create > Blob; sets this automatically) ---
BLOB_READ_WRITE_TOKEN=

# --- Facility ---
# Room opening hours and "today" are interpreted in this timezone.
FACILITY_TIMEZONE=Asia/Bangkok

# --- Background jobs ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Required for /api/cron/*.
CRON_SECRET=
# Minimum seconds between status sweeps triggered by traffic (no-shows, reminders). 0 disables.
STATUS_SWEEP_INTERVAL_SECONDS=60

# --- Public demo ---
# Reset all data to the seed every day (cron) and allow seeding demo accounts in production.
DEMO_MODE=false
# Demo accounts are listed on the sign-in page in development only. Set "true" or "false" to override.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=

# --- Optional ---
# The address people use to reach this site, used in sitemap and check-in QR codes.
# NEXT_PUBLIC_APP_URL=https://rooms.example.com
# Extra browser origins allowed to send state-changing requests (comma separated).
# EXTRA_CORS_ORIGINS=
# Only when frontend and API are on sibling subdomains, e.g. .example.com
# SESSION_COOKIE_DOMAIN=
