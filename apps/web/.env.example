# Everything is optional: the app runs entirely in the browser and needs no database or server secrets.

# The address people use to reach this site. Used for the sitemap, social previews and QR check-in codes.
# On Vercel the production domain is picked up automatically.
# NEXT_PUBLIC_APP_URL=https://rooms.example.com

# Demo accounts are listed on the sign-in page in development only. Set "true" or "false" to override.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Room opening hours and "today" are interpreted in this timezone.
# NEXT_PUBLIC_FACILITY_TIMEZONE=Asia/Bangkok
